# Force LF line endings for everything — CRLF checkouts on Windows corrupt
# JSON-form Dockerfile instructions (trailing \r glues into the last arg,
# e.g. 'node --import tsx /app/server.ts\r' → ERR_MODULE_NOT_FOUND %0D) and
# break shell scripts. 'text eol=lf' also keeps .ps1 portable (PowerShell
# accepts LF).
* text=auto eol=lf
Dockerfile text eol=lf
entrypoint.sh text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=lf
*.mts text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.ini text eol=lf
# Binary / machine assets — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.sqlite binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.lock binary
*.node binary