    "better-sqlite3": "^13.0.2",
    "cheerio": "^1.2.0",
    "country-state-city": "^3.2.1",
    "currency-codes": "^2.2.0",
    "dotenv": "^17.2.3",
    "driver.js": "^1.8.0",
    "express": "^4.21.2",
    "ini": "^7.0.0",
    "languages": "^0.1.3",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
